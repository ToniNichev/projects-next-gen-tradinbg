# =============================================================================
# Next-Gen Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values for your environment
# The bot will automatically load these variables on startup via python-dotenv
#
# Quick Setup:
#   cp env.example .env
#   nano .env  (edit your API keys and settings)
#   ./deploy.sh install  (macOS automated setup)
#   ./start.sh  (start as background service)
#
# =============================================================================
# BINANCE.US API CREDENTIALS (REQUIRED)
# =============================================================================
BINANCE_US_KEY=your_api_key_here
BINANCE_US_SECRET=your_api_secret_here
# IMPORTANT: Use Binance.US API keys with SPOT TRADING permission ONLY.
# Disable WITHDRAWAL permission. IP-whitelist your server.

# =============================================================================
# TRADING STRATEGY PARAMETERS
# =============================================================================
BOT_SYMBOL=BTC/USDT
BOT_TIMEFRAME=1h               # Recommended: 1h. Do NOT use 5m for live.
BOT_SHORT_WINDOW=12
BOT_LONG_WINDOW=26
BOT_ORDER_PCT=0.25             # 25% of balance per trade
BOT_INITIAL_USDT=1000.0
BOT_FEE_RATE=0.00075          # 0.075% Binance.US fee
BOT_SLIPPAGE=0.0005           # 0.05% slippage

# =============================================================================
# RISK MANAGEMENT (IMPORTANT!)
# =============================================================================
BOT_STOP_LOSS_PCT=0.025        # 2.5% stop loss
BOT_TAKE_PROFIT_PCT=0.04       # 4% take profit
BOT_TRAILING_STOP_PCT=0.015    # 1.5% trailing stop
BOT_USE_TRAILING_STOP=true
BOT_MAX_POSITION_SIZE=0.35     # Max 35% per trade
BOT_MIN_POSITION_SIZE=0.15     # Min 15% per trade
BOT_USE_DYNAMIC_SIZING=true    # Adjust size based on volatility
BOT_MAX_TRADES_PER_DAY=5       # Prevent overtrading

# =============================================================================
# STRATEGY FILTERS
# =============================================================================
BOT_MIN_TREND_STRENGTH=0.00005
BOT_RSI_PERIOD=14
BOT_RSI_OVERSOLD=25
BOT_RSI_OVERBOUGHT=75

# ATR (Volatility) Settings
BOT_ATR_PERIOD=14
BOT_ATR_STOP_MULTIPLIER=2.5
BOT_USE_ATR_STOPS=true

# MACD Settings
BOT_MACD_FAST=12
BOT_MACD_SLOW=26
BOT_MACD_SIGNAL=9
BOT_REQUIRE_MACD_CONFIRMATION=false

# Volume Confirmation
BOT_REQUIRE_VOLUME_CONFIRMATION=true
BOT_VOLUME_THRESHOLD=1.1

# =============================================================================
# MULTI-STRATEGY CONFIGURATION (NEW!)
# =============================================================================
# Enable multiple trading strategies working together
BOT_USE_MULTI_STRATEGY=true

# Signal aggregation mode:
#   voting          - Simple majority (democratic)
#   weighted_voting - Weighted by confidence (recommended)
#   unanimous       - All strategies must agree (conservative)
#   any             - Any strategy can trigger (aggressive)
#   best            - Use most confident strategy
BOT_STRATEGY_AGGREGATION_MODE=weighted_voting

# Minimum signal confidence (0.0 to 1.0). 0.5+ recommended for live trading;
# anything lower will overtrade and bleed via fees/slippage.
BOT_MIN_SIGNAL_CONFIDENCE=0.5

# Strategy 1: EMA Crossover (Trend Following)
BOT_STRATEGY_EMA_ENABLED=true
BOT_STRATEGY_EMA_WEIGHT=1.0

# Strategy 2: RSI + Bollinger Bands (Mean Reversion)
BOT_STRATEGY_RSI_BB_ENABLED=true
BOT_STRATEGY_RSI_BB_WEIGHT=1.0
BOT_STRATEGY_RSI_BB_RSI_OVERSOLD=30
BOT_STRATEGY_RSI_BB_RSI_OVERBOUGHT=70
BOT_STRATEGY_RSI_BB_BB_PERIOD=20
BOT_STRATEGY_RSI_BB_BB_STD_DEV=2.0
BOT_STRATEGY_RSI_BB_STOP_LOSS_PCT=0.02
BOT_STRATEGY_RSI_BB_TAKE_PROFIT_PCT=0.03
# These previously had no env var and were stuck at the strategy's hardcoded
# defaults regardless of config — now wired through.
BOT_STRATEGY_RSI_BB_RSI_EXTREME_OVERSOLD=20
BOT_STRATEGY_RSI_BB_RSI_EXTREME_OVERBOUGHT=80
BOT_STRATEGY_RSI_BB_BB_TOUCH_THRESHOLD=0.995
BOT_STRATEGY_RSI_BB_REQUIRE_BOTH_SIGNALS=true
BOT_STRATEGY_RSI_BB_USE_VOLUME_FILTER=true
BOT_STRATEGY_RSI_BB_VOLUME_THRESHOLD=1.0

# Strategy 3: MACD + Volume (Momentum Breakout)
BOT_STRATEGY_MACD_ENABLED=true
BOT_STRATEGY_MACD_WEIGHT=1.0
BOT_STRATEGY_MACD_FAST_PERIOD=12
BOT_STRATEGY_MACD_SLOW_PERIOD=26
BOT_STRATEGY_MACD_SIGNAL_PERIOD=9
BOT_STRATEGY_MACD_VOLUME_MULTIPLIER=1.3
BOT_STRATEGY_MACD_REQUIRE_ZERO_CROSS=false
# Min |histogram|/price to confirm a signal (not a raw dollar value). Filters
# the noisy near-zero histogram right at a fresh crossover. 0.0003 filters
# roughly the weakest quarter of readings on BTC/USDT 1h; recalibrate if you
# change symbol/timeframe.
BOT_STRATEGY_MACD_HISTOGRAM_THRESHOLD=0.0003
BOT_STRATEGY_MACD_STOP_LOSS_PCT=0.025
BOT_STRATEGY_MACD_TAKE_PROFIT_PCT=0.05
# These previously had no env var and were stuck at the strategy's hardcoded
# defaults regardless of config — now wired through.
BOT_STRATEGY_MACD_SIGNAL_LOOKBACK=3
BOT_STRATEGY_MACD_VOLUME_MA_PERIOD=20
BOT_STRATEGY_MACD_USE_MOMENTUM_FILTER=true
BOT_STRATEGY_MACD_MOMENTUM_PERIOD=10
BOT_STRATEGY_MACD_MIN_MOMENTUM=0.005
BOT_STRATEGY_MACD_DETECT_DIVERGENCE=true
BOT_STRATEGY_MACD_DIVERGENCE_LOOKBACK=14

# =============================================================================
# DASHBOARD SECURITY SETTINGS
# =============================================================================
# Enable/disable authentication (NEVER set to false on a public host!)
DASHBOARD_AUTH_ENABLED=true

# Dashboard login credentials.
# DASHBOARD_PASSWORD must be a bcrypt hash for production.  Generate with:
#   python -c "from auth import hash_password_cli; print(hash_password_cli('YOUR_STRONG_PASSWORD'))"
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# API Key for programmatic access.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=

# Security settings
DASHBOARD_REQUIRE_HTTPS=false
DASHBOARD_ENABLE_RATE_LIMITING=true
DASHBOARD_RATE_LIMIT_PER_MINUTE=60
# Restrict to your real frontend origin(s) in production. "*" is unsafe.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:8000

# =============================================================================
# LIVE TRADING CONFIGURATION (⚠️ HANDLE WITH EXTREME CARE!)
# =============================================================================
# Trading mode: "paper" (simulated) | "dry_run" (logged only) | "live" (REAL MONEY!)
BOT_TRADING_MODE=paper

# Safety flag - MUST be explicitly set to "true" for live trading
# This is a double-check to prevent accidental live trading
BOT_LIVE_TRADING_ENABLED=false

# Require confirmation for trades above this USD value
BOT_REQUIRE_TRADE_CONFIRMATION=true
BOT_CONFIRMATION_THRESHOLD_USD=100.0

# Maximum single trade size (safety limit). Start small for live trading.
BOT_MAX_SINGLE_TRADE_USD=50.0

# Order polling (fills / terminal state)
BOT_ORDER_POLL_TIMEOUT_SECONDS=10.0
BOT_ORDER_POLL_INTERVAL_SECONDS=0.5

# Exchange protective stop (LIVE spot STOP_LOSS_LIMIT after buys; mirrors software stops)
BOT_EXCHANGE_STOP_LOSS_ENABLED=true
BOT_EXCHANGE_STOP_UPDATE_ON_TRAILING=true

# Portfolio peak-equity drawdown: halt new buys when drawdown exceeds BOT_MAX_PORTFOLIO_DRAWDOWN
BOT_PORTFOLIO_DRAWDOWN_KILL_ENABLED=true

# Kline websocket: alert if no messages for this many seconds (partial klines count)
# Binance.US liquidity is thin overnight; 180-330s produces false-positive reconnects
# during quiet hours. 600s gives headroom while still catching real outages fast
# (genuine socket errors bypass this timer via on_error's immediate stale flag).
BOT_WS_WATCHDOG_ENABLED=true
BOT_WS_STALE_ALERT_SECONDS=600

# Notifications (optional; set any channel you use — failures are logged only)
# Generic JSON webhook
# BOT_NOTIFY_WEBHOOK_URL=https://example.com/hook
# ntfy — https://ntfy.sh or self-hosted
# BOT_NOTIFY_NTFY_TOPIC=your-secret-topic
# BOT_NOTIFY_NTFY_SERVER=https://ntfy.sh
# Telegram bot
# BOT_NOTIFY_TELEGRAM_BOT_TOKEN=
# BOT_NOTIFY_TELEGRAM_CHAT_ID=
# Pushover
# BOT_NOTIFY_PUSHOVER_USER_KEY=
# BOT_NOTIFY_PUSHOVER_APP_TOKEN=

# Preflight ONLY: scripts/validate_exchange_stops.py --auth --place-cancel-test
# BOT_VALIDATE_STOP_ACK=I_ACCEPT_SPOT_STOP_TEST

# Test notifications once configured:
#   python scripts/test_notify.py
# Long dry_run session (signals, no orders):
#   python scripts/run_dry_run_foreground.py

# =============================================================================
# DASHBOARD CONFIGURATION
# =============================================================================
# Bind to 127.0.0.1 and use an SSH tunnel to reach the dashboard.
# Only switch to 0.0.0.0 if the dashboard sits behind a properly
# configured reverse proxy with TLS and access controls.
BOT_DASHBOARD_HOST=127.0.0.1
BOT_DASHBOARD_PORT=8000

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
BOT_DATABASE_URL=sqlite:///data/trading.db
BOT_ENABLE_DATABASE=true
BOT_ENABLE_CSV_LOGGING=true
BOT_TRADES_LOG_PATH=data/trade_log.csv

# =============================================================================
# QUICK START - macOS Server Deployment
# =============================================================================
# 
# Automated Installation:
#   ./deploy.sh install      # Complete setup with menu
#   ./start.sh               # Start bot as background service
#   ./status.sh              # Check status and logs
#   ./monitor.sh             # Health check
#
# Manual Setup:
#   1. Copy this file:      cp env.example .env
#   2. Edit settings:       nano .env
#   3. Install deps:        pip install -r requirements.txt
#   4. Run bot:             python3 main.py
#   5. Access dashboard:    http://localhost:8000
#
# Management:
#   ./start.sh               # Start service
#   ./stop.sh                # Stop service
#   ./restart.sh             # Restart service
#   ./status.sh              # View status
#   ./monitor.sh             # Health check
#   ./backup.sh              # Backup data
#   ./run.sh                 # Run in foreground (testing)
#
# API Access:
#   curl -H "Authorization: Bearer YOUR_API_KEY" http://localhost:8000/api/stats
#   curl -u admin:changeme http://localhost:8000/api/stats
#
# Security:
#   # Generate secure password hash:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
#   
#   # Generate API key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Documentation:
#   QUICKSTART.md            # 5-minute setup guide
#   DEPLOYMENT.md            # Complete deployment guide
#   DEPLOYMENT_SUMMARY.md    # Scripts reference
#   README.md                # Main documentation
#
# =============================================================================
