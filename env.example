# =============================================================================
# Next-Gen Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values for your environment
# The bot will automatically load these variables on startup via python-dotenv

# =============================================================================
# BINANCE.US API CREDENTIALS
# =============================================================================
BINANCE_US_KEY=your_api_key_here
BINANCE_US_SECRET=your_api_secret_here

# =============================================================================
# TRADING STRATEGY PARAMETERS
# =============================================================================
BOT_SYMBOL=BTC/USDT
BOT_TIMEFRAME=1h
BOT_SHORT_WINDOW=12
BOT_LONG_WINDOW=26
BOT_ORDER_PCT=0.25
BOT_INITIAL_USDT=1000.0
BOT_FEE_RATE=0.00075
BOT_SLIPPAGE=0.0005

# =============================================================================
# DASHBOARD SECURITY SETTINGS
# =============================================================================
# Enable/disable authentication (set to false for local development only!)
DASHBOARD_AUTH_ENABLED=true

# Dashboard login credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# API Key for programmatic access (optional)
DASHBOARD_API_KEY=

# Security settings
DASHBOARD_REQUIRE_HTTPS=false
DASHBOARD_ENABLE_RATE_LIMITING=true
DASHBOARD_RATE_LIMIT_PER_MINUTE=60
DASHBOARD_ALLOWED_ORIGINS=*

# =============================================================================
# DASHBOARD CONFIGURATION
# =============================================================================
BOT_DASHBOARD_HOST=0.0.0.0
BOT_DASHBOARD_PORT=8000

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
BOT_DATABASE_URL=sqlite:///data/trading.db
BOT_ENABLE_DATABASE=true
BOT_ENABLE_CSV_LOGGING=true
BOT_TRADES_LOG_PATH=data/trade_log.csv

# =============================================================================
# USAGE EXAMPLES
# =============================================================================
# 
# 1. Start the bot: python main.py
# 2. Run backtest: python backtest.py 30
# 3. Access dashboard: http://localhost:8000/ui
# 4. API key auth: curl -H "Authorization: Bearer YOUR_API_KEY" http://localhost:8000/api/stats
# 5. Basic auth: curl -u admin:changeme http://localhost:8000/api/stats
#
# To generate bcrypt password hash:
#   python -c "from auth import hash_password_cli; print(hash_password_cli('your_password'))"
#
# =============================================================================
